			    sil=all; quote caca 'man_trad' pis 'poss ['man_trad']' ; sil=all;    
		        end
		     end
		  end
		  loop=nd 0 (nnodes ['ref_tree']) 
		         set onetocero grptogrp 'opt_tree' 'ref_tree' ;
		         if (#nd == #tx || (!isintree['ref_tree' #nd] ) ) 
			        if (#tx > 10000  ) daaa end     
