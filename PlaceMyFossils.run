	              set error 'false_pos['nod']' ;
	           end 
		  if ('error' == 7777777 ) 
		      continue ; 
		  end
		  if ('error' < 'mini_err') 
		     set mini_err 'error' ;
		  end 
		  if ('error' > 'maxi_err') 
		     set maxi_err 'error' ;
		  end
	 else
	        if ('toinv[#nd]' == (-1) ) 
