macfloat 'flot_calc' ;



if ('doing_grp_anal') 
 set mini_err_grp['cual'] 9999999 ; 
 set maxi_err_grp['cual'] 0 ; 
	 loop=nd 0 (nnodes[0] ) 
	   set falses_neg [#nd 'cual' ] 'negg[#nd]' ; 
