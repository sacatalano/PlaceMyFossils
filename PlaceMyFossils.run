	      if ('guicherr' ==  1 ) sil-file; quote Complete ,'greens[0]' &10; sil=all; end
	      if ('guicherr' ==  2 ) sil-file; quote Complete ,'reds[0]'   &10; sil=all; end
	  end
	  
	 if ('doerror_w_grps'  )
	 loop=uu 0 ('numchrgrp'-1)
