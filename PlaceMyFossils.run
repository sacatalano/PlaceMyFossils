                set dientes deslist [ 'opt_tree' 'mano'] ;
		loop=di 0 1
	            sil=all; quote placing #tx 'mano' mano dientes[#di] 'dientes[#di]' out= outgroup ; sil=All; 
		    if ('dientes[#di]' == #tx )
		      if ('yacambN[outgroup]' == 0 ) 
		        set poss[outgroup] ++ ; 
