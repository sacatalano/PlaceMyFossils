	      sil=all; quote tiempo 'tiempo' pruned 'prunne' arbol #yy 'elesco'  elmini 'elmini' &10; sil=all; 
	   end
	end
	
	if ('elesco' <= 'elmini')
		 sil=all; tp #yy; sil=all; 
		 if ('elesco' < 'elmini' )
		    set greene 0 ;
		 else
		  set greene ++ ;
		 end
		 set elmini 'elesco' ; 
