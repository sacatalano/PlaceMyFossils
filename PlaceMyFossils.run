	        end
	    else
	          ttag &+ write <rect x=&34 'pos_x'&34&32y=&34 'pos_y'&34&32width=&34 'sizsq'&34&32height=&34 'sizsq'&34&32style=&34fill:rgb('red','green','blue')&59 stroke:none&34 /> &10 ;sil=all; 
            end
