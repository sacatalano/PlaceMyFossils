mybestscore['grusize'] guichsp                  multisp                 shoft   
bl_name[100]            guichval                multree                 sizsq   
blue                    hayconts          myout[100]            son_uno son_cero        
bran    haylands        n                       sonamb  
bran_ref                haytax                  nconds                       
ccc                     innewick                nds                     span    
